    <Lib
      OutputFile="$(OutDir)$(ProjectName).lib"
      Sources="$(OutDir)$(TargetName).lib;$(SolutionDir)build\artifacts\ntdll_extra_stub\$(Platform)\$(Configuration)\ntdll_extra.lib" />
  </Target>

