    <ClInclude Include="mhook_inject.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="mhook_inject.cpp" />
    <ClCompile Include="inject_entry.c">
      <!-- Force a non-LTCG object on x86 so the compiler emits _except_handler3
           (provided by mhook_seh3.lib).  Under /GL (Release WholeProgramOptimization)
           the x86 compiler emits the /GS-cookie _except_handler4 even with /GS-,
           which would require the full GS-cookie SEH machinery.  x64 is unaffected
           (table-based SEH via ntdll's __C_specific_handler). -->
      <WholeProgramOptimization Condition="'$(Platform)'=='Win32'">false</WholeProgramOptimization>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <!-- x64 bootstrap thunk: only assembled for x64 targets -->
    <MASM Include="inject_bootstrap_thunk_x64.asm">
      <ExcludedFromBuild Condition="'$(Platform)'!='x64'">true</ExcludedFromBuild>
    </MASM>
    <!-- x86 bootstrap thunk: only assembled for Win32 targets.  The item must be
         Condition'd out (not merely ExcludedFromBuild) on x64, because on x64 the same
         file is also pulled in as a CustomBuild item below to generate the cross-arch
         data blob — and VS refuses to load a project where one file appears under two
         item types simultaneously. -->
    <MASM Include="inject_bootstrap_thunk_x86.asm" Condition="'$(Platform)'=='Win32'">
      <UseSafeExceptionHandlers>true</UseSafeExceptionHandlers>
    </MASM>
    <!-- Delayed-entry thunks: guarantee JMP (not call) to original entry point -->
    <MASM Include="inject_delayed_entry_thunk_x64.asm">
      <ExcludedFromBuild Condition="'$(Platform)'!='x64'">true</ExcludedFromBuild>
    </MASM>
    <MASM Include="inject_delayed_entry_thunk_x86.asm">
      <UseSafeExceptionHandlers>true</UseSafeExceptionHandlers>
      <ExcludedFromBuild Condition="'$(Platform)'!='Win32'">true</ExcludedFromBuild>
    </MASM>
  </ItemGroup>

  <!-- ===== Cross-arch x86 bootstrap thunk for the 64->32 path (x64 build only) =====
       ml64 can't assemble x86, so a CustomBuild assembles inject_bootstrap_thunk_x86.asm
       with the 32-bit ml.exe and re-emits its bytes as a native-MASM .const DB blob
       (utils/Asm-To-MasmDataBlob.ps1); that generated .asm is then assembled by ml64 and
       linked normally, exposing InjectBootstrapThunkX86Begin/End for mhook_inject.cpp.
       Same generate-in-IntDir-then-consume pattern as the message-table below. -->
  <ItemGroup Condition="'$(Platform)'=='x64'">
    <CustomBuild Include="inject_bootstrap_thunk_x86.asm">
      <Command>pwsh -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\..\..\utils\Asm-To-MasmDataBlob.ps1" -SourceAsm "%(FullPath)" -AssemblerPath "$(VC_ExecutablePath_x64_x86)\ml.exe" -DumpbinPath "$(VC_ExecutablePath_x64_x64)\dumpbin.exe" -OutputAsm "$(IntDir)inject_bootstrap_thunk_x86_data.asm" -BeginLabel InjectBootstrapThunkX86Begin -EndLabel InjectBootstrapThunkX86End -EndSymbol InjectBootstrapThunkEnd</Command>
      <Outputs>$(IntDir)inject_bootstrap_thunk_x86_data.asm;%(Outputs)</Outputs>
      <Message>gen x86 cross-arch thunk blob</Message>
    </CustomBuild>
  </ItemGroup>

  <!-- Feed the generated blob to ml64 at build time rather than as a static <MASM>
       project item.  A static item shows up as a (phantom) source file in Solution
       Explorer, and the MASM build-customization rule ignores <Visible>false</Visible>.
       Adding it inside a target keeps it out of the IDE's static item set entirely
       while still assembling + linking it: an item added to @(MASM) before _MASM
       persists for the rest of the build, so _MASM assembles it and the later
       ComputeMASMObj / ComputeMASMOutput targets feed its .obj to Obj/Lib/Link.
       x64-only, matching the CustomBuild that emits the .asm above. -->
  <Target Name="AddGeneratedX86ThunkToMasm"
          Condition="'$(Platform)'=='x64'"
          BeforeTargets="_MASM">
    <ItemGroup>
      <MASM Include="$(IntDir)inject_bootstrap_thunk_x86_data.asm" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="inject_entry.def" />
  </ItemGroup>

  <!-- ===== Message-table resource (dynamic builds only) =====
       mc.exe -c compiles mhook_inject_messages.mc into a .rc + MSG00409.bin whose message
       IDs equal the public MHOOK_INJECT_E_* HRESULTs (the -c "Customer bit" flag yields
       0xA00000xx).  The generated .rc is then compiled and linked into mhook_inject.dll so
       the strings are retrievable via FormatMessage(FORMAT_MESSAGE_FROM_HMODULE, ...).
       Excluded from the static (.lib) configs — those carry no resource. -->
  <ItemGroup>
    <CustomBuild Include="mhook_inject_messages.mc">
      <ExcludedFromBuild Condition="'$(ConfigurationType)'!='DynamicLibrary'">true</ExcludedFromBuild>
      <Command>mc.exe -c -U -h "$(IntDir)." -r "$(IntDir)." "%(FullPath)"</Command>
      <Outputs>$(IntDir)mhook_inject_messages.rc;$(IntDir)MSG00409.bin;%(Outputs)</Outputs>
      <Message>mc %(Filename)%(Extension)</Message>
    </CustomBuild>
  </ItemGroup>

  <!-- Compile the generated message-table .rc at build time rather than as a static
       ResourceCompile project item — a static item shows as a phantom source file in
       Solution Explorer, and ResourceCompile ignores <Visible>false</Visible> here too.
       The .mc CustomBuild above (generate-sources phase) emits the .rc; this target runs
       right after it and adds the .rc to @(ResourceCompile).  The ResourceCompile target's
       '@(ResourceCompile)'!='' condition is evaluated at run time, so it then compiles the
       .rc, and ComputeRCOutputs feeds the resulting .res into Link.  Dynamic configs only,
       matching the CustomBuild's own ExcludedFromBuild gate.  (Same hide-from-IDE rationale
       as AddGeneratedX86ThunkToMasm above.) -->
  <Target Name="AddGeneratedMessageTableRc"
          Condition="'$(ConfigurationType)'=='DynamicLibrary'"
          AfterTargets="CustomBuild">
    <ItemGroup>
      <ResourceCompile Include="$(IntDir)mhook_inject_messages.rc">
        <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      </ResourceCompile>
    </ItemGroup>
  </Target>

