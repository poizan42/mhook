  <!-- Build-order dependency on ntdll_extra_stub so ntdll_extra.lib exists when
       the linker runs.  LinkLibraryDependencies=false prevents MSBuild from
       auto-injecting the lib as a linker input (which caused "entry point not
       found in mhook-unit-tests.exe"); the #pragma comment in nt_defs.h
       resolves it instead via $(OutDir) in AdditionalLibraryDirectories. -->
  <ItemGroup>
    <ProjectReference Include="..\ntdll_extra_stub\ntdll_extra_stub.vcxproj">
      <Project>{B1E3F8C2-4A5D-4F9E-8B2C-1D6E7A3F9B04}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>

